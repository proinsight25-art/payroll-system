{% load static %}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>ProInsight Payroll — Secure Payroll for Zimbabwe</title>
  <link rel="stylesheet" href="{% static 'css/payroll-landing.css' %}">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <div class="brand">
        <img src="{% static 'images/company-logo.png' %}" alt="ProInsight logo" class="logo">
        <span class="brand-name">ProInsight Payroll</span>
      </div>
      <nav class="nav">
        <a href="#features">Features</a>
        <a href="#calculator">Calculator</a>
        <a href="#pricing">Pricing</a>
        <a href="{% url 'login' %}" class="btn-link">Sign in</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="hero">
      <div class="container hero-grid">
        <div class="hero-copy">
          <h1>Payroll that’s accurate, compliant, and local</h1>
          <p class="lead">Process payslips, statutory returns and payments for Zimbabwean payrolls — fast, secure, and audit ready.</p>
          <div class="hero-ctas">
            <a class="btn-primary" href="#calculator">Try the take‑home calculator</a>
            <a class="btn-outline" href="#pricing">Book a demo</a>
          </div>

          <div class="trust-row">
            <span class="trusted">Trusted by <strong>200+</strong> businesses</span>
            <img src="{% static 'images/iso-badge.png' %}" alt="ISO certified" class="badge">
          </div>
        </div>

        <aside class="hero-login">
          <div class="login-card">
            <h2>Employee Login</h2>
            <form method="post" action="{% url 'login' %}">
              {% csrf_token %}
              <label for="id_username">Username</label>
              <input id="id_username" name="username" type="text" required>
              <label for="id_password">Password</label>
              <input id="id_password" name="password" type="password" required>
              <button type="submit" class="btn-primary">Sign in</button>
              <p class="small">Secure connection • Data encrypted</p>
            </form>
            <a class="link-small" href="{% url 'password_reset' %}">Forgot password?</a>
          </div>
        </aside>
      </div>
    </section>

    <section id="calculator" class="container calculator">
      <h3>Free tool — Estimate take‑home pay</h3>
      <form id="takehome" class="calc-form" onsubmit="event.preventDefault(); calculate();">
        <label>Monthly gross salary</label>
        <input id="gross" type="number" placeholder="e.g. 150000" required>
        <button class="btn-outline" type="submit">Calculate take‑home</button>
        <div id="result" class="calc-result" aria-live="polite"></div>
      </form>
    </section>

    <section id="features" class="container features">
      <h3>Why ProInsight</h3>
      <div class="feature-grid">
        <div class="feature">
          <h4>Local compliance</h4>
          <p>Built for Zimbabwe statutory rules — PAYE, NSSA, pension exports and ZIMRA files.</p>
        </div>
        <div class="feature">
          <h4>Secure by design</h4>
          <p>Encrypted data, role‑based access, and audit logs for every action.</p>
        </div>
        <div class="feature">
          <h4>Employee self‑service</h4>
          <p>Password‑protected payslips, downloadable PDFs and payslip history.</p>
        </div>
      </div>
    </section>

    <footer class="site-footer">
      <div class="container">
        <small>© {{ now.year }} ProInsight Payroll • Built for Zimbabwe</small>
      </div>
    </footer>
  </main>

  <script>
    function calculate(){
      const gross = Number(document.getElementById('gross').value) || 0;
      const paye = Math.round(gross * 0.20);
      const nssa = Math.round(gross * 0.05);
      const net = gross - paye - nssa;
      document.getElementById('result').textContent = `PAYE: ${paye.toLocaleString()} • NSSA: ${nssa.toLocaleString()} • Take‑home: ${net.toLocaleString()}`;
    }
  </script>
</body>
</html>
